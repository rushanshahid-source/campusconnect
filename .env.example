# ── Auth ────────────────────────────────────────────────────────
APP_SECRET=               # Long random string used to sign/verify the session JWT

# ── Database (PostgreSQL) ───────────────────────────────────────
# Full Postgres connection string, e.g.
#   postgres://user:password@host:5432/dbname?sslmode=require
# Managed options: Vercel Postgres / Neon / Supabase / Railway.
DATABASE_URL=

# ── Admin Role (optional) ───────────────────────────────────────
OWNER_EMAIL=              # Account registered with this email gets role "admin"
